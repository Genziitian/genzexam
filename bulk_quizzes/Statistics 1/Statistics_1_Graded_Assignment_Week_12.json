      "prompt": [
        {
          "kind": "text",
          "value": "The total duration (in minutes) of a badminton match in the Premier Badminton League (PBL) is\nuniformly distributed between [a, b] with variance 12 square minutes. The probability that a match will\nlast at most m minutes is 1/p. Find the expected time duration (in minutes) of a badminton match."
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "m+6-12/p"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Uniform variance 12 implies b−a=12. Since F(m)=1/p, a=m−12/p; the mean a+6 is m+6−12/p."
        }
      ]
    },
