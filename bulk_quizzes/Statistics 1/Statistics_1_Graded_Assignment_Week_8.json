    {
      "prompt": [
        {
          "kind": "text",
          "value": "Factory A produces x times as many items as factory B, while B and C produce equal numbers. Their defective proportions are p%,q%,r%, respectively. All items are pooled and one item is selected randomly.\nWhat is the probability that the item is defective?"
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "(x*p+q+r)/(100*(x+2))",
        "(xp+q+r)/(100(x+2))"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Factory production weights are x:1:1. Apply the law of total probability to the defect percentages."
        }
      ]
    },
    {
      "prompt": [
        {
          "kind": "text",
          "value": "Factory A produces x times as many items as factory B, while B and C produce equal numbers. Their defective proportions are p%,q%,r%, respectively. All items are pooled and one item is selected randomly.\nGiven that the item is defective, what is the probability that factory B produced it?"
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "q/(x*p+q+r)",
        "q/(xp+q+r)"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Bayes’ formula divides the defective contribution from factory B by the total defective contribution."
        }
      ]
    },
    {
      "prompt": [
        {
          "kind": "text",
          "value": "A particular task is given to three persons, Manoj, Kalpana and Ananya whose proba-\nbilities of completing it are a\nb,c\nd and e\nf respectively, independent of each other. What\nis the probability that the task will be completed? \nConditions: 1 ≤a ≤3, a + 1 < b ≤6, 2 ≤c ≤5, c + 1 ≤d ≤9, 1 ≤e ≤4 and\ne + 1 ≤f ≤8."
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "1-(1-a/b)*(1-c/d)*(1-e/f)",
        "1-(1-a/b)(1-c/d)(1-e/f)"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "The task is unfinished only if all three independent people fail."
        }
      ]
    },
    {
      "prompt": [
        {
          "kind": "text",
          "value": "If A and B are two independent events such that P(Ac) = m and P(Bc) = x and\nP(A ∪ B) = n, then calculate the value of x. \nConditions: 0.5 ≤m ≤0.8 and 0.6 ≤n ≤0.9"
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "(1-n)/m"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Independence gives P(Aᶜ∩Bᶜ)=P(Aᶜ)P(Bᶜ)=mx. This is the complement of the given union, with probability 1−n."
        }
      ]
    },
