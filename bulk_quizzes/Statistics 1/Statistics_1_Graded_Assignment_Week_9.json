      "prompt": [
        {
          "kind": "text",
          "value": "A discrete random variable X takes values 1,2,…,n with CDF F(x)=(x²+k)/m at those values. Find k."
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "m-n^2",
        "m-n**2"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "A CDF must satisfy F(n)=1 at the largest support value; hence (n²+k)/m=1."
        }
      ]
    },
