        {
          "kind": "text",
          "value": "In how many ways can a group of n −m players be formed from n state level players\nand m district level players such that the group contains exactly 1 district level player?"
        },
        {
          "kind": "text",
          "value": "Give an expression in the stated parameters."
        }
      ],
      "marks": 1,
      "difficulty": "medium",
      "type": "short_answer",
      "acceptable_answers": [
        "m*binom(n,n-m-1)",
        "mbinom(n,n-m-1)"
      ],
      "explanation": [
        {
          "kind": "text",
          "value": "Choose the single district-level player in m ways, then n−m−1 of the n state-level players."
        }
      ]
