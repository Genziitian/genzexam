      "marks": 2,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "Explanation: P(X=5) = (1-0.1)^4 × 0.1 = 0.9^4 × 0.1 = 0.6561 × 0.1 = 0.0656 ≈ 0.066."
        }
