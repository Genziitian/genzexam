    {
      "type": "numerical",
      "prompt": [
        {
          "kind": "text",
          "value": "Solve for $x$: $2^{2x} - 5 \\cdot 2^x + 4 = 0$. Find the positive root."
        }
      ],
      "numerical_answer": 2,
      "numerical_tolerance": 0.01,
      "marks": 1,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "Let $u = 2^x$. $u^2 - 5u + 4 = 0 \\implies (u - 1)(u - 4) = 0 \\implies u = 1$ or $4$. $2^x = 4 \\implies x = 2$."
        }
      ]
