        [
          {
            "kind": "text",
            "value": "$2$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$5$"
          }
        ]
      ],
      "correct_answer": 0,
      "marks": 1,
      "difficulty": "easy",
      "explanation": [
        {
          "kind": "text",
          "value": "$\\deg(P \\cdot Q) = \\deg(P) + \\deg(Q) = 3 + 1 = 4$."
        }
      ]
