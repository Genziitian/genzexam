            "kind": "text",
            "value": "$y = \\frac{xz}{x + z}$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$y = \\frac{2(x + z)}{xz}$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$y = \\sqrt{xz}$"
          }
        ]
      ],
      "correct_answer": 0,
      "marks": 1,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "Let $a^x = b^y = c^z = k$. Then $a = k^{1/x}, b = k^{1/y}, c = k^{1/z}$. $b^2 = ac \\implies k^{2/y} = k^{1/x + 1/z} \\implies \\frac{2}{y} = \\frac{x + z}{xz} \\implies y = \\frac{2xz}{x + z}$."
        }
      ]
    },
