      "type": "numerical",
      "prompt": [
        {
          "kind": "text",
          "value": "Find the number of vertices in a planar graph where edges intersect only at their endpoints, given 12 edges and 8 faces."
        }
      ],
      "numerical_answer": 6,
      "numerical_tolerance": 0.01,
      "marks": 2,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "By Euler's formula $V - E + F = 2 \\implies V - 12 + 8 = 2 \\implies V - 4 = 2 \\implies V = 6$."
        }
      ]
