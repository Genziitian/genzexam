          {
            "kind": "text",
            "value": "$4, 4, 3, 2, 1$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$3, 3, 2, 2, 1, 1$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$4, 3, 2, 1, 0$"
          }
        ]
      ],
      "correct_answer": 2,
      "marks": 1,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "By the Handshaking Lemma, the sum of degrees must be even: $3 + 3 + 2 + 2 + 1 + 1 = 12$ (even)."
        }
