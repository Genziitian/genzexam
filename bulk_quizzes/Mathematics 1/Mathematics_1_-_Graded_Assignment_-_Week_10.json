      "prompt": [
        {
          "kind": "text",
          "value": "The maximum number of non-zero entries in an adjacency matrix of a simple graph having $n$ vertices can be:"
        }
      ],
      "options": [
        [
          {
            "kind": "text",
            "value": "$n^2$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$\\frac{n(n - 1)}{2}$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$\\frac{n(n - 1)}{4}$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$n(n - 1)$"
          }
        ]
      ],
      "correct_answer": 3,
      "marks": 1,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "In a directed simple graph without self-loops, each vertex can connect to at most $n - 1$ other vertices, giving at most $n(n - 1)$ directed edges."
        }
      ]
    },
    {
      "type": "mcq_single",
      "prompt": [
