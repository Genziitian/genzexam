    {
      "type": "mcq_multi",
      "prompt": [
        {
          "kind": "text",
          "value": "Let $f: \\mathbb{R} \\to \\mathbb{R}$ be defined by $f(x) = x^3 - 3x$. Which of the following statements is (are) correct?"
        }
      ],
      "options": [
        [
          {
            "kind": "text",
            "value": "$f$ is an even function."
          }
        ],
        [
          {
            "kind": "text",
            "value": "$f$ is an odd function."
          }
        ],
        [
          {
            "kind": "text",
            "value": "$f(x) = 0$ has three distinct real roots."
          }
        ],
        [
          {
            "kind": "text",
            "value": "$f$ is strictly increasing on $\\mathbb{R}$."
          }
        ]
      ],
      "correct_answers": [
        1,
        2
      ],
      "marks": 4,
      "difficulty": "hard",
      "explanation": [
        {
          "kind": "text",
          "value": "$f(-x) = (-x)^3 - 3(-x) = -x^3 + 3x = -f(x)$, so $f$ is odd. $x^3 - 3x = x(x^2 - 3) = 0$ has roots $0, \\pm\\sqrt{3}$, which are 3 distinct real roots."
        }
      ]
