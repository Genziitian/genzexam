      "numerical_answer": 24,
      "numerical_tolerance": 0.01,
      "marks": 1,
      "difficulty": "easy",
      "explanation": [
        {
          "kind": "text",
          "value": "$x^2 + (x + 2)^2 = 290 \\implies 2x^2 + 4x + 4 = 290 \\implies x^2 + 2x - 143 = 0 \\implies x = 11$. $a = 11, b = 13 \\implies a + b = 24$."
        }
      ]
