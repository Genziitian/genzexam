      "options": [
        [
          {
            "kind": "text",
            "value": "$(1/2, 3/2)$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$(1, 4)$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "$(0, 0)$"
          }
        ],
        [
          {
            "kind": "text",
            "value": "They do not intersect."
          }
        ]
      ],
      "correct_answer": 0,
      "marks": 1,
      "difficulty": "medium",
      "explanation": [
        {
          "kind": "text",
          "value": "$4x^2 + x = 5x - 1 \\implies 4x^2 - 4x + 1 = 0 \\implies (2x - 1)^2 = 0 \\implies x = 1/2$. Then $y = 5(1/2) - 1 = 3/2$. Point is $(1/2, 3/2)$."
        }
      ]
