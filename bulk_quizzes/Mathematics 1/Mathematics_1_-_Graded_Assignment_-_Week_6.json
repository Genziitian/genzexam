    {
      "type": "numerical",
      "prompt": [
        {
          "kind": "text",
          "value": "If $m^{\\log_3 2} + 2^{\\log_3 m} = 16$, then what is the value of $m$?"
        }
      ],
      "numerical_answer": 27,
      "numerical_tolerance": 0.01,
      "marks": 2,
      "difficulty": "hard",
      "explanation": [
        {
          "kind": "text",
          "value": "Identity: $m^{\\log_3 2} = 2^{\\log_3 m}$. Thus $2 \\cdot 2^{\\log_3 m} = 16 \\implies 2^{\\log_3 m} = 8 = 2^3 \\implies \\log_3 m = 3 \\implies m = 3^3 = 27$."
        }
      ]
