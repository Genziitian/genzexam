Options -MultiViews
DirectoryIndex landing.html index.html
RewriteEngine On

# Backend API: Laravel lives in backend/, reached as /public/api/... or /api/...
RewriteRule ^public/(.*)$ backend/public/$1 [L]
RewriteRule ^api/(.*)$ backend/public/api/$1 [L]

# Public landing page at the root only
RewriteRule ^$ landing.html [L]
RewriteRule ^papers/?$ papers.html [L]
RewriteRule ^paper-pricing/?$ paper-pricing.html [L]

# Everything else falls through to the SPA
RewriteCond %{REQUEST_URI} !^/(public|api)/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Caching: never cache HTML entry points, cache hashed assets forever.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^index-[A-Za-z0-9]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(exam-platform|app-enhancements|papers|paper-pricing|storefront-runtime|storefront-dashboard)\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
