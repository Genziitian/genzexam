Options -MultiViews
DirectoryIndex landing.html index.html
RewriteEngine On

# Never serve private application state, source, backup folders or hidden files.
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(data|mobile|tests|docs|design|templates\.[^/]+|assets\.[^/]+)(/|$) - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+backend[/?\s] [NC]
RewriteRule ^ - [F,L]
<FilesMatch "\.(env|log|sqlite|sql|bak|lock|py|md|toml|ya?ml)$|^(composer|package)(-lock)?\.json$|^server\.js$">
  Require all denied
</FilesMatch>

# Backend API: Laravel lives in backend/, reached as /public/api/... or /api/...
RewriteRule ^public/(.*)$ backend/public/$1 [L]
RewriteRule ^api/(.*)$ backend/public/api/$1 [L]

# Public landing page at the root only
RewriteRule ^$ landing.html [L]
RewriteRule ^papers/?$ papers.html [L]
RewriteRule ^manager/sales/?$ manager-sales.html [L]
RewriteRule ^manager/discussions/?$ manager-discussions.html [L]
RewriteRule ^paper-pricing/?$ paper-pricing.html [L]
RewriteRule ^privacy-policy/?$ privacy.html [L]
RewriteRule ^terms-and-conditions/?$ terms.html [L]
RewriteRule ^refund-policy/?$ refund-policy.html [L]
RewriteRule ^delete-account/?$ delete-account.html [L]

RewriteRule ^exams?(/.*)?$ exams.html [L]

# Papers open in the self-paced paper room; old quiz links are sent there.
RewriteRule ^paper/[0-9]+/?$ paper-room.html [L]
RewriteRule ^quiz/([0-9]+)/?$ /paper/$1 [R=302,L]

# Everything else falls through to the SPA
RewriteCond %{REQUEST_URI} !^/(public|api)/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Caching: never cache HTML entry points, cache hashed assets forever.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "^index-[A-Za-z0-9]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(sw|ql-theme|ql-tokens|ql-redesign|ql-dark-[a-z]+|exam-platform|exam-rich-content|exam-calculator|app-enhancements|more-web|paper-room|papers|paper-pricing|manager-sales|manager-discussions|storefront-runtime|storefront-dashboard)\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
