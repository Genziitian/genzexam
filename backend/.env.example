APP_NAME="LAB by GenZIITian"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://labapi.genziitian.in
FRONTEND_URL=https://exam.genziitian.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lab_genziitian
DB_USERNAME=root
DB_PASSWORD=
SANCTUM_STATEFUL_DOMAINS=localhost:5173,exam.genziitian.in
SANCTUM_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://exam.genziitian.in

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@labbygenziitian.com
MAIL_FROM_NAME="LAB by GenZIITian"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://labapi.genziitian.in/public/api/auth/google/callback

PISTON_API_URL=https://emkc.org/api/v2/piston
CODE_EXECUTOR=piston

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_INPUT_CHARS=60000
DEEPSEEK_MAX_QUESTIONS=100
STUDENT_PAPER_MAX_PDF_PAGES=30
STUDENT_PAPER_DAILY_AI_CONVERSIONS=10
STUDENT_PAPER_UPLOAD_LIMIT=5
STUDENT_PAPER_FREE_UPLOAD_LIMIT=1
STUDENT_PAPER_UPLOAD_WINDOW_DAYS=7

# Android Pro subscriptions. JSON credentials belong outside public_html.
GOOGLE_PLAY_PACKAGE_NAME=in.genziitian.quizlab
GOOGLE_PLAY_PRO_PRODUCT_ID=quiz_lab_pro_monthly
GOOGLE_PLAY_PRO_BASE_PLAN_ID=monthly
GOOGLE_PLAY_PRO_TRIAL_OFFER_ID=trial-7-days
GOOGLE_PLAY_REGIONS_VERSION=2022/02
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Wrapped, authenticated Cloud Pub/Sub push (enable only after deployment).
GOOGLE_PLAY_RTDN_TOPIC=projects/teaching-lms/topics/quizlab-play-rtdn
GOOGLE_PLAY_RTDN_SUBSCRIPTION=projects/teaching-lms/subscriptions/quizlab-play-rtdn-sub
GOOGLE_PLAY_RTDN_AUDIENCE=https://labapi.genziitian.in/public/api/membership/google-play/notifications
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GenZ IITian partner-coupons API (server-side only)
GENZ_API_URL=
GENZ_API_KEY=
